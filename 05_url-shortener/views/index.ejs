<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>URL Shortener</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th,
        td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }

        tr:nth-child(even) {
            background-color: #f9f9f9;
        }

        #urlForm {
            margin-bottom: 20px;
        }

        input[type="text"] {
            width: 300px;
            padding: 10px;
            margin-right: 10px;
        }

        button {
            padding: 10px 15px;
            cursor: pointer;
        }

        #result {
            margin: 15px 0;
            padding: 10px;
            background-color: #e7f3ff;
            border: 1px solid #b3d7ff;
            border-radius: 4px;
        }
    </style>
</head>

<body>
    <h4>Server-side Rendering with EJS</h4>
    <h1>URL Shortener</h1>
    <!-- JavaScript intercepts this form and sends its value to the creation endpoint. -->
    <form id="urlForm">
        <input type="text" id="originalUrl" placeholder="Enter URL to shorten" required />
        <button type="submit">Shorten</button>
    </form>
    <div id="result"></div>

    <!-- Section to display all URL mappings -->
    <hr>
    <h2>All Shortened URLs</h2>
    <div id="urlsList">

        <table border="1" style="width: 100%; border-collapse: collapse; margin-top: 10px;">
            <tr>
                <th>Short Code</th>
                <th>Original URL</th>
                <th>Short URL</th>
                <th>Clicks</th>
            </tr>
            <!-- EJS runs on the server and repeats this row for every saved URL document. -->
            <% urls.forEach(url=> { %>
                <tr>
                    <td>
                        <%= url.shortId %>
                    </td>
                    <td><a href="<%= url.redirectURL %>" target="_blank" rel="noopener noreferrer">
                            <%= url.redirectURL %>
                        </a></td>
                    <td><a href="/<%= url.shortId %>" target="_blank" rel="noopener noreferrer"><%= url.shortId %></a>
                    </td>
                    <td>
                        <%= url.visitHistory.length %>
                    </td>
                </tr>
                <% }); %>
        </table>
    </div>

    <script>
        // Prevent a normal page reload so the server can return a short code as JSON.
        document
            .getElementById('urlForm')
            .addEventListener('submit', async (e) => {
                e.preventDefault();
                const originalUrl = document.getElementById('originalUrl').value;

                const result = document.getElementById('result');
                try {
                    // Send JSON to POST /url; Express parses it with express.json().
                    const response = await fetch('/url', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ url: originalUrl }),
                    });
                    const data = await response.json();
                    if (!response.ok) {
                        // Turn an HTTP error response into a visible message below.
                        throw new Error(data.error || 'Unable to shorten URL');
                    }

                    // Build an absolute short link using the current host and port.
                    const shortUrl = new URL(`/${data.id}`, window.location.origin);
                    result.replaceChildren('Short URL: ');
                    const link = document.createElement('a');
                    link.href = shortUrl.href;
                    link.target = '_blank';
                    link.rel = 'noopener noreferrer';
                    link.textContent = shortUrl.href;
                    result.appendChild(link);

                    // Add the new mapping to the visible table without reloading the page.
                    const row = document.createElement('tr');
                    for (const value of [data.id, data.url, shortUrl.href, '0']) {
                        const cell = document.createElement('td');
                        if (value === data.url || value === shortUrl.href) {
                            // Create links as DOM elements rather than inserting URL text as HTML.
                            const link = document.createElement('a');
                            link.href = value;
                            link.target = '_blank';
                            link.rel = 'noopener noreferrer';
                            link.textContent = value;
                            cell.appendChild(link);
                        } else {
                            cell.textContent = value;
                        }
                        row.appendChild(cell);
                    }
                    document.querySelector('#urlsList table').appendChild(row);
                } catch (error) {
                    result.textContent = `Error: ${error.message}`;
                }
            });
    </script>
</body>

</html>