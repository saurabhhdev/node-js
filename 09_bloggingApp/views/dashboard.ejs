<%- include('partials/header', { title: 'Dashboard | Blog App' }) %>

<div class="container page-container py-4 py-md-5">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
        <div>
            <p class="text-primary text-uppercase small fw-bold mb-1">Your space</p>
            <h1 class="page-heading mb-0">Dashboard</h1>
        </div>
        <% if (typeof user !== 'undefined' && user) { %>
            <a class="btn btn-primary" href="/blog/add-new">Write a blog</a>
        <% } %>
    </div>
    <% if (typeof user !== 'undefined' && user) { %>
        <p class="text-muted">You are signed in.</p>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <h2 class="page-heading h3 mt-4 mb-3">Your blogs</h2>
    <% if (blogs && blogs.length > 0) { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 blog-grid">
            <% blogs.forEach((blog) => { %>
                <div class="col">
                    <article class="card blog-card">
                        <% if (blog.coverImage) { %>
                            <img src="<%= blog.coverImage %>" class="blog-card-image" alt="Cover photo for <%= blog.title %>" loading="lazy">
                        <% } %>
                        <div class="card-body blog-card-body p-3">
                            <div class="author-info mb-3">
                                <img
                                    class="author-avatar"
                                    src="<%= blog.author && blog.author.profileImage ? blog.author.profileImage : '/images/default.png' %>"
                                    alt=""
                                    loading="lazy">
                                <span class="author-name"><%= blog.author && blog.author.username ? blog.author.username : (user && user.username ? user.username : 'You') %></span>
                            </div>
                            <h3 class="h5 page-heading blog-card-title"><%= blog.title %></h3>
                            <p class="blog-card-excerpt text-secondary"><%= blog.content && blog.content.length > 180 ? blog.content.substring(0, 180) + '...' : (blog.content || '') %></p>
                            <p class="blog-meta mt-auto"><%= new Date(blog.createdAt).toLocaleDateString() %></p>
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-outline-primary btn-sm" href="/blog/<%= blog._id %>">View</a>
                                <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#edit-<%= blog._id %>">Edit</button>
                                <form action="/blog/delete/<%= blog._id %>" method="POST" onsubmit="return confirm('Delete this blog?')">
                                    <button class="btn btn-outline-danger btn-sm" type="submit">Delete</button>
                                </form>
                            </div>
                            <form class="collapse mt-3" id="edit-<%= blog._id %>" action="/blog/edit/<%= blog._id %>" method="POST">
                                <label class="form-label" for="title-<%= blog._id %>">Title</label>
                                <input class="form-control mb-2" id="title-<%= blog._id %>" name="title" value="<%= blog.title %>" required>
                                <label class="form-label" for="content-<%= blog._id %>">Content</label>
                                <textarea class="form-control mb-2" id="content-<%= blog._id %>" name="content" rows="5" required><%= blog.content %></textarea>
                                <button class="btn btn-primary btn-sm" type="submit">Save changes</button>
                            </form>
                        </div>
                    </article>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <h3 class="h5">No blogs yet</h3>
                <p class="text-muted mb-0">Your published stories will appear here.</p>
            </div>
        </div>
    <% } %>
</div>

<%- include('partials/footer') %>
