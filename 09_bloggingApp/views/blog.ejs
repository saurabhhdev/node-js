<%- include('partials/header', { title: 'Blog | Blog App' }) %>

<div class="container page-container py-4 py-md-5">
    <% if (typeof blog !== 'undefined' && blog) { %>
        <article class="card blog-detail border-0 shadow-sm mx-auto overflow-hidden">
            <% if (blog.coverImage) { %>
                <img src="<%= blog.coverImage %>" class="blog-detail-image" alt="Cover photo for <%= blog.title %>">
            <% } %>
            <div class="card-body p-3 p-md-5">
                <h1 class="page-heading display-6"><%= blog.title %></h1>
                <div class="author-info blog-meta mb-4">
                    <img
                        class="author-avatar"
                        src="<%= blog.author && blog.author.profileImage ? blog.author.profileImage : '/images/default.png' %>"
                        alt=""
                        loading="lazy">
                    <div>
                        <div class="author-name"><%= blog.author && blog.author.username ? blog.author.username : 'Unknown author' %></div>
                        <small><%= new Date(blog.createdAt).toLocaleDateString() %></small>
                    </div>
                </div>
                <div class="blog-content mb-4" style="white-space: pre-wrap;"><%= blog.content %></div>
                <div class="d-flex align-items-center gap-3">
                    <% if (typeof user !== 'undefined' && user) { %>
                        <form action="/blog/like/<%= blog._id %>" method="POST">
                            <button class="btn btn-outline-primary" type="submit">Like (<%= blog.likes ? blog.likes.length : 0 %>)</button>
                        </form>
                    <% } else { %>
                        <span class="blog-meta"><%= blog.likes ? blog.likes.length : 0 %> likes</span>
                    <% } %>
                    <a href="/" class="btn btn-link">Back to blogs</a>
                </div>

                <section class="mt-5" aria-labelledby="comments-heading">
                    <h2 class="h4 mb-3" id="comments-heading">
                        Comments (<%= blog.comments ? blog.comments.length : 0 %>)
                    </h2>

                    <% if (typeof user !== 'undefined' && user) { %>
                        <form class="mb-4" action="/comment/<%= blog._id %>" method="POST">
                            <label class="form-label" for="comment-content">Add a comment</label>
                            <textarea
                                class="form-control mb-2"
                                id="comment-content"
                                name="content"
                                rows="3"
                                maxlength="2000"
                                required></textarea>
                            <button class="btn btn-primary" type="submit">Post comment</button>
                        </form>
                    <% } else { %>
                        <p><a href="/user/login">Sign in</a> to leave a comment.</p>
                    <% } %>

                    <% if (blog.comments && blog.comments.length > 0) { %>
                        <% blog.comments.forEach((comment) => { %>
                            <article class="border-top py-3">
                                <div class="d-flex justify-content-between align-items-start gap-3">
                                    <div class="author-info">
                                        <img
                                            class="author-avatar"
                                            src="<%= comment.author && comment.author.profileImage ? comment.author.profileImage : '/images/default.png' %>"
                                            alt=""
                                            loading="lazy">
                                        <span class="author-name"><%= comment.author && comment.author.username ? comment.author.username : 'Unknown user' %></span>
                                    </div>
                                    <% if (typeof user !== 'undefined' && user && comment.author && String(comment.author._id) === String(user.id)) { %>
                                        <form action="/comment/delete/<%= blog._id %>/<%= comment._id %>" method="POST">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                        </form>
                                    <% } %>
                                </div>
                                <p class="mt-2 mb-1" style="white-space: pre-wrap;"><%= comment.content %></p>
                                <% if (comment.createdAt) { %>
                                    <small class="blog-meta"><%= new Date(comment.createdAt).toLocaleDateString() %></small>
                                <% } %>
                            </article>
                        <% }); %>
                    <% } else { %>
                        <p class="text-muted">No comments yet.</p>
                    <% } %>
                </section>

            </div>
        </article>
    <% } else { %>
        <section class="card">
            <h1>Blog not found</h1>
            <a href="/">Back to home</a>
        </section>
    <% } %>
</div>

<%- include('partials/footer') %>
