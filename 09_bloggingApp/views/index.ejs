<%- include('partials/header', { title: 'Home | Blog App' }) %>

<div class="container page-container py-4 py-md-5">
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger" role="alert"><%= error %></div>
    <% } %>

    <section class="welcome-section mb-5">
        <% if (typeof user !== 'undefined' && user) { %>
            <h1 class="welcome-title">Welcome back, <%= user.username || 'Writer' %>.</h1>
            <p class="welcome-copy mb-3">Read something new or share a story of your own.</p>
            <div class="welcome-actions">
                <a class="btn btn-primary" href="/blog/add-new">Write a story</a>
                <a class="welcome-link" href="/dashboard">Your dashboard</a>
            </div>
        <% } else { %>
            <h1 class="welcome-title">A place for good stories.</h1>
            <p class="welcome-copy mb-3">Share what’s on your mind. Find a new point of view.</p>
            <div class="welcome-actions">
                <a class="btn btn-primary" href="/user/signup">Join the community</a>
                <a class="welcome-link" href="/user/login">Sign in</a>
            </div>
        <% } %>
    </section>

    <section id="stories">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-2 mb-3">
            <h2 class="page-heading mb-0">Latest stories</h2>
            <span class="story-count"><%= blogs ? blogs.length : 0 %> stories</span>
        </div>
        <% if (blogs && blogs.length > 0) { %>
            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 blog-grid">
                <% blogs.forEach((blog) => { %>
                    <div class="col">
                        <article class="card blog-card">
                            <% if (blog.coverImage) { %>
                                <img src="<%= blog.coverImage %>" class="blog-card-image" alt="Cover photo for <%= blog.title %>" loading="lazy">
                            <% } %>
                            <div class="card-body blog-card-body p-3 p-lg-4">
                                <div class="author-info mb-3">
                                    <img
                                        class="author-avatar"
                                        src="<%= blog.author && blog.author.profileImage ? blog.author.profileImage : '/images/default.png' %>"
                                        alt=""
                                        loading="lazy">
                                    <span class="author-name"><%= blog.author && blog.author.username ? blog.author.username : 'Unknown author' %></span>
                                </div>
                                <h3 class="h5 page-heading blog-card-title"><%= blog.title %></h3>
                                <p class="blog-card-excerpt text-secondary mb-3"><%= blog.content && blog.content.length > 180 ? blog.content.substring(0, 180) + '...' : (blog.content || '') %></p>
                                <div class="blog-meta mt-auto mb-3">
                                    <span><%= new Date(blog.createdAt).toLocaleDateString() %></span>
                                    <span aria-hidden="true"> · </span>
                                    <span><%= blog.likes ? blog.likes.length : 0 %> likes</span>
                                </div>
                                <a href="/blog/<%= blog._id %>" class="btn btn-primary align-self-start">Read story <span aria-hidden="true">→</span></a>
                            </div>
                        </article>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="empty-stories">
                <div class="card-body text-center py-5">
                    <h3 class="h6 mb-1">No stories yet</h3>
                    <p class="text-muted mb-0">Be the first to share one.</p>
                </div>
            </div>
        <% } %>
    </section>
</div>

<%- include('partials/footer') %>
