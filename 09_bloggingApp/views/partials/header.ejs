<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title || 'Blog App' %>
    </title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --page-bg: #f5f7fa;
            --ink: #202a36;
            --muted: #6b7785;
            --brand: #315fce;
            --card-border: #e7ebf0;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: var(--page-bg);
            color: var(--ink);
        }

        main { flex: 1; }
        .navbar {
            background: linear-gradient(110deg, #17243b, #263957) !important;
            box-shadow: 0 2px 12px rgb(22 34 51 / 8%);
        }
        .navbar-brand { letter-spacing: -.03em; }
        .nav-link { transition: color .15s ease; }
        .nav-link:hover { color: #fff !important; }
        :focus-visible { outline: 3px solid #83aaff; outline-offset: 3px; }
        .page-container { max-width: 1120px; }
        .page-heading { font-weight: 700; letter-spacing: -.03em; }
        .welcome-section { max-width: 720px; padding: 1.5rem 0 1rem; }
        .welcome-title {
            margin: 0 0 .5rem;
            font-size: clamp(2rem, 5vw, 3rem);
            font-weight: 700;
            letter-spacing: -.045em;
            line-height: 1.15;
        }
        .welcome-copy { max-width: 54ch; color: var(--muted); line-height: 1.6; }
        .welcome-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1rem; }
        .welcome-actions .btn { padding: .6rem 1rem; border-radius: .45rem; }
        .welcome-link { color: var(--brand); font-weight: 600; text-decoration: none; }
        .welcome-link:hover { text-decoration: underline; }
        .story-count { color: var(--muted); font-size: .9rem; }
        .blog-grid { row-gap: 1.25rem; }
        .blog-card {
            height: 100%;
            overflow: hidden;
            background: #fff;
            border: 1px solid var(--card-border);
            border-radius: .65rem;
        }
        .blog-card-image {
            width: 100%;
            aspect-ratio: 16 / 10;
            object-fit: cover;
            background: #e9edf3;
        }
        .blog-card-body { display: flex; flex-direction: column; }
        .blog-card-title {
            display: -webkit-box;
            overflow: hidden;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 2;
        }
        .blog-card-excerpt {
            display: -webkit-box;
            overflow: hidden;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
        }
        .blog-meta { color: var(--muted); font-size: .875rem; }
        .empty-stories { border: 1px solid var(--card-border); border-radius: .65rem; background: #fff; }
        .author-info { display: flex; align-items: center; gap: .65rem; min-width: 0; }
        .author-avatar {
            width: 2.5rem;
            height: 2.5rem;
            flex: 0 0 2.5rem;
            border-radius: 50%;
            object-fit: cover;
            background: #e9edf3;
        }
        .author-name { overflow: hidden; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
        .nav-user {
            display: inline-flex;
            align-items: center;
            gap: .55rem;
        }
        .nav-user-avatar {
            width: 2rem;
            height: 2rem;
            border: 2px solid rgb(255 255 255 / 45%);
            border-radius: 50%;
            object-fit: cover;
        }
        .welcome-name { color: #fff; font-weight: 700; }
        .blog-detail { max-width: 800px; }
        .blog-detail-image {
            width: 100%;
            max-height: 480px;
            object-fit: cover;
        }
        .blog-content { line-height: 1.8; overflow-wrap: anywhere; }
        .site-footer { color: #d7deea; background: #17243b; }
        .site-footer p { margin: 0; }
        .comment-form { padding: clamp(1rem, 3vw, 1.5rem); border: 1px solid var(--card-border); border-radius: .75rem; background: #f9fafc; }
        .comment-item { overflow-wrap: anywhere; }

        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
        }

        @media (max-width: 575.98px) {
            .welcome-section { padding-top: .5rem; }
            .welcome-title { font-size: clamp(2rem, 9vw, 2.6rem); }
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">Blogify</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <% if (locals.user) { %>
                        <!-- Show these when user IS logged in -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle nav-user" href="#" role="button" data-bs-toggle="dropdown"
                                aria-expanded="false">
                                <img
                                    class="nav-user-avatar"
                                    src="<%= user.profileImage || '/images/default.png' %>"
                                    alt=""
                                    loading="lazy">
                                <span>Hello! <strong class="welcome-name"><%= user.username || 'Writer' %></strong></span>
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="/dashboard">Dashboard</a></li>
                                <li>
                                    <form action="/user/logout" method="POST">
                                        <button class="dropdown-item" type="submit">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                        <% } else { %>
                            <!-- Show these when user is NOT logged in -->
                            <li class="nav-item">
                                <a class="nav-link" href="/user/login">Login</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/user/signup">Signup</a>
                            </li>
                            <% } %>
                </ul>
            </div>
        </div>
    </nav>
    <main>